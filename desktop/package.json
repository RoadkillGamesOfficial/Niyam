{
  "name": "niyam-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Electron shell for Niyam. Supervises the local server, restarts it when it dies, lives in the tray and reminds from the background.",
  "author": "Rohil Jain",
  "main": "main.js",
  "scripts": {
    "start": "node prepare.mjs && electron .",
    "dist": "node prepare.mjs --check && electron-builder --win nsis",
    "test": "node --test \"test/*.test.js\"",
    "spike:node": "node spike/check-node.mjs",
    "spike:server": "node spike/check-server.mjs",
    "spike:electron": "node spike/check-electron.mjs"
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.rohil.niyam",
    "productName": "Niyam",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "error.html",
      "tray.js",
      "tray-menu.js",
      "lifecycle.js",
      "supervisor.js",
      "notify.js",
      "reminder-db.js",
      "reminder-timer.js",
      "assets/tray.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../.next/standalone",
        "to": "app/.next/standalone",
        "filter": ["**/*", "!node_modules/**"]
      },
      {
        "from": "../.next/standalone/node_modules",
        "to": "app/.next/standalone/node_modules"
      },
      {
        "from": "../migrations",
        "to": "app/migrations"
      },
      {
        "from": "../prompts",
        "to": "app/prompts"
      },
      {
        "from": "../src",
        "to": "app/src"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Niyam",
      "include": "installer.nsh",
      "artifactName": "Niyam Setup ${version}.exe",
      "deleteAppDataOnUninstall": false
    }
  }
}
